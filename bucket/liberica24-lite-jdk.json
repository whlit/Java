{
    "description": "BellSoft Liberica is a 100% open-source Java 24 implementation",
    "homepage": "https://bell-sw.com/java",
    "version": "24.0.1-11",
    "license": "GPL-2.0-only WITH Classpath-exception-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bell-sw/Liberica/releases/download/24.0.1%2B11/bellsoft-jdk24.0.1%2B10-windows-amd64-lite.zip",
            "hash": "sha1:b04c20c27592100a9b9cf043b190a60c39895ce4"
        }
    },
    "extract_dir": "jdk-24.0.1-lite",
    "env_add_path": "bin",
    "env_set": {
        "JAVA_HOME": "$dir"
    },
    "checkver": {
        "url": "https://api.bell-sw.com/v1/liberica/releases?version-feature=24&bundle-type=jdk-lite&version-modifier=latest&release-type=all&os=windows&arch=x86&installation-type=archive&package-type=zip&output=json&fields=version",
        "jsonpath": "$.version",
        "regex": "(?<major>[\\d.]+)(?:\\+)(?<build>[\\d]+)",
        "replace": "${major}-${build}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bell-sw/Liberica/releases/download/$matchMajor%2B$matchBuild/bellsoft-jdk$matchMajor%2B$matchBuild-windows-amd64-lite.zip"
            }
        },
        "hash": {
            "url": "https://api.bell-sw.com/v1/liberica/releases/$basename",
            "jsonpath": "$.sha1"
        },
        "extract_dir": "jdk-$matchMajor-lite"
    }
}
